---
import { siteContent } from "../data/content";
import FlowDiagram from "./FlowDiagram.astro";
import SectionPrompt from "./SectionPrompt.astro";

const { projects } = siteContent;
---

<section id="projects" class="px-11 pb-[52px] pt-2 max-[920px]:px-[22px]">
  <SectionPrompt title={projects.title} path={projects.path} cmd={projects.cmd} class="mb-[26px]" />
  <div class="grid grid-cols-2 gap-4 max-[920px]:grid-cols-1">
    {projects.cards.map((card) => (
      <div class:list={["flex flex-col overflow-hidden rounded-xl border border-line bg-surface transition-[transform,border-color,box-shadow] duration-[180ms] hover:-translate-y-1 hover:border-accent hover:shadow-[0_14px_34px_rgba(0,0,0,0.45)]", card.wide && "col-span-2 max-[920px]:col-span-1"]}>
        <div class="flex items-center gap-2 border-b border-line px-4 py-[11px] font-mono text-xs text-faint">
          <span class:list={["h-2 w-2 rounded-full", card.dot === "green" ? "bg-green" : "bg-accent"]} aria-hidden="true"></span>
          {card.titlebar}
        </div>
        <div class="border-b border-line bg-band px-4 py-3">
          <FlowDiagram nodes={card.flow} title={`${card.title} — architecture`} />
        </div>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="mb-2 text-lg font-semibold text-ink">{card.title}</h3>
          <div class="text-sm leading-relaxed text-muted">{card.description}</div>
          <div class="mt-3 font-mono text-xs text-muted-2">{card.highlight}</div>
          <div class="mt-4 flex gap-3.5 font-mono text-xs">
            {card.links.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("#") ? undefined : "_blank"}
                rel={link.href.startsWith("#") ? undefined : "noopener noreferrer"}
                class:list={[
                  "border-b pb-0.5 transition-colors duration-150",
                  link.primary
                    ? "border-accent text-accent hover:opacity-70"
                    : "border-line-2 text-body hover:border-accent hover:text-accent",
                ]}
              >{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
