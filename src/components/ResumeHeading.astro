---
/**
 * Résumé section heading: the print-palette twin of SectionPrompt.
 * Screen readers get the plain section title instead of the prompt.
 */
interface Props {
  title: string;
  path: string;
  cmd: string;
  class?: string;
}
const { title, path, cmd, class: className } = Astro.props;
---

<h2 class:list={["rsec-heading mono m-0 text-xs font-normal", className]}>
  <span class="sr-only">{title}</span>
  <span aria-hidden="true">
    <span class="font-bold text-r-green">{path}</span>
    <span class="text-r-muted"> $ </span>
    <span class="text-r-ink">{cmd}</span>
  </span>
</h2>

<style>
  .rsec-heading {
    border-bottom: 1.5px solid var(--color-r-ink);
    padding-bottom: 4px;
    margin: 11px 0 7px;
  }

  .mono {
    font-family: var(--font-mono);
  }
</style>
