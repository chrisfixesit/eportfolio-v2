---
import { Image } from "astro:assets";
import { siteContent } from "../data/content";
import profilePhoto from "../assets/profile-photo.jpg";

const { hero } = siteContent;

const ctaClasses: Record<string, string> = {
  solid:
    "rounded-lg bg-accent px-[22px] py-[13px] font-bold text-page transition-[transform,box-shadow] duration-150 hover:-translate-y-0.5 hover:shadow-[0_10px_26px_rgba(255,153,0,0.32)]",
  outline:
    "rounded-lg border border-line-2 px-[22px] py-[13px] text-body transition-colors duration-150 hover:border-accent hover:text-accent",
  ghost: "px-1 py-[13px] text-faint transition-colors duration-150 hover:text-accent",
};
---

<div class="grid grid-cols-[1.1fr_0.9fr] max-[920px]:grid-cols-1">
  <!-- left: terminal prompt + name + CTAs -->
  <div class="relative overflow-hidden px-11 pb-14 pt-[60px] max-[920px]:px-[22px] max-[920px]:pb-9 max-[920px]:pt-11">
    <div class="bg-grid-overlay absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="relative">
      <div class="mb-[22px] font-mono text-sm">
        <div class="min-h-5 text-green">
          $ <span id="hero-type">{hero.command}</span><span id="hero-caret" class="caret ml-0.5" aria-hidden="true"></span>
        </div>
        <div id="hero-out" class="mt-1 text-[13px] text-muted-2">{hero.commandOutput}</div>
      </div>
      <h1 class="m-0 font-mono text-[64px] font-extrabold leading-[1.02] tracking-[-0.03em] text-ink max-[920px]:text-[46px] max-[560px]:text-[38px]">
        {hero.nameLines[0]}<br />{hero.nameLines[1]}<span class="text-accent">.</span>
      </h1>
      <p class="mb-[30px] mt-6 max-w-[520px] text-lg leading-relaxed text-[#a7b2bd]">
        {hero.summary}
      </p>
      <div class="flex flex-wrap items-center gap-3 font-mono text-sm">
        {hero.ctas.map((cta) => (
          <a href={cta.href} class={ctaClasses[cta.variant]}>{cta.label}</a>
        ))}
      </div>
      <div class="mt-[22px] font-mono text-[13px] text-green">{hero.status}</div>
    </div>
  </div>

  <!-- right: photo in a terminal frame -->
  <div class="flex items-center py-12 pl-2 pr-11 max-[920px]:px-[22px] max-[920px]:pb-10 max-[920px]:pt-0">
    <div class="ml-auto w-full max-w-[340px] overflow-hidden rounded-xl border border-line bg-surface shadow-[0_20px_50px_rgba(0,0,0,0.4)] max-[920px]:ml-0 max-[920px]:max-w-[260px]">
      <div class="flex items-center gap-2 border-b border-line px-3.5 py-[9px] font-mono text-[11px] text-faint">
        <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>{hero.photo.titlebar}
      </div>
      <div class="relative aspect-[4/5] w-full">
        <Image
          src={profilePhoto}
          alt={hero.photo.alt}
          widths={[480, 720, 960]}
          sizes="(max-width: 920px) 260px, 340px"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</div>

<script>
  // One-shot terminal prompt: type the command, then print its output.
  // The full text is server-rendered, so no-JS and reduced-motion visitors see it immediately.
  const typed = document.getElementById("hero-type");
  const out = document.getElementById("hero-out");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (typed && out && !reduceMotion) {
    const full = typed.textContent ?? "";
    typed.textContent = "";
    out.style.visibility = "hidden";
    let i = 0;
    const type = () => {
      i += 1;
      typed.textContent = full.slice(0, i);
      if (i < full.length) setTimeout(type, 55);
      else setTimeout(() => (out.style.visibility = ""), 320);
    };
    setTimeout(type, 400);
  }
</script>
