---
import { siteContent } from "../data/content";

const { skills } = siteContent;
---

<section id="skills" class="px-11 pb-[52px] pt-2 max-[920px]:px-[22px]">
  <div class="section-label mb-[26px]">
    {skills.label} <span class="text-faint">{skills.cmd}</span>
  </div>
  <div class="grid grid-cols-2 gap-3.5 max-[920px]:grid-cols-1">
    {skills.cards.map((card) => (
      <div class="rounded-[10px] border border-line bg-surface px-5 py-[18px]">
        <div class="mb-3 font-mono text-[13px] text-ink">{card.title}</div>
        <div class="flex flex-wrap gap-[7px]">
          {card.tags.map((tag) => <span class="pill">{tag}</span>)}
          <span class="pill text-faint">{card.more}</span>
        </div>
      </div>
    ))}
  </div>
</section>
