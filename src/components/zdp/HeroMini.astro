---
// A static picture of the live hero, scaled down. Not wired to content.ts on purpose.
const cta = "rounded-md px-3 py-1.5 font-mono text-[11px]";
---

<div
  data-mini
  data-page="baseline"
  class="group overflow-hidden rounded-lg border border-line-2 bg-surface shadow-[0_14px_36px_rgba(0,0,0,0.4)] data-[shake]:animate-[zdp-shake_0.4s_ease-in-out]"
  role="img"
  aria-label="Miniature of the christophercorbin.cloud home page. It changes when the flag is on."
>
  <!-- browser chrome: a picture of a browser, so light greys are intentional -->
  <div class="flex items-center gap-2 bg-[#e9edf1] px-3 py-2" aria-hidden="true">
    <span class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-tl-red"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-tl-yellow"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-tl-green"></span>
    </span>
    <span class="flex-1 truncate rounded bg-[#ffffff] px-3 py-1 font-mono text-[11px] text-[#4a5561]">https://christophercorbin.cloud</span>
  </div>

  <!-- page -->
  <div class="bg-page">
    <div
      data-mini-bar
      class="hidden items-center group-data-[page=flagged]:flex justify-between gap-3 bg-accent px-3 py-1.5 font-mono text-[11px] text-page"
    >
      <span>new · the résumé now downloads as a one-page PDF</span>
      <span class="shrink-0 opacity-80">flag: resume-pdf</span>
    </div>
    <div class="flex items-center gap-3 border-b border-line px-3 py-2 font-mono text-[10.5px] text-faint">
      <span class="flex gap-1">
        <span class="h-1.5 w-1.5 rounded-full bg-tl-red"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-tl-yellow"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-tl-green"></span>
      </span>
      <span>~/christopher-corbin — zsh</span>
      <span class="ml-auto flex gap-3 max-[480px]:hidden"><span>projects</span><span>about</span><span>contact</span></span>
    </div>
    <div class="px-5 pb-6 pt-5">
      <div class="font-mono text-[11px] text-green">$ whoami --role</div>
      <div class="mt-0.5 font-mono text-[10.5px] text-muted-2">// DevOps &amp; Cloud Engineer</div>
      <div class="mt-3 font-mono text-[34px] font-extrabold leading-[1.02] tracking-[-0.03em] text-ink">
        Christopher<br />Corbin<span class="text-accent">.</span>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class:list={[cta, "bg-accent font-bold text-page"]}>watch a deploy</span>
        <span class:list={[cta, "border border-line-2 text-body"]}>view projects</span>
        <span
          data-mini-resume
          class:list={[
            cta,
            "border border-line-2 text-body transition-[background-color,color,box-shadow] duration-300",
            "group-data-[page=flagged]:border-accent group-data-[page=flagged]:bg-accent group-data-[page=flagged]:font-bold group-data-[page=flagged]:text-page group-data-[page=flagged]:shadow-[0_0_0_3px_rgba(255,153,0,.25)]",
          ]}
        >
          <span class="group-data-[page=flagged]:hidden">resume</span>
          <span class="hidden group-data-[page=flagged]:inline">↓ resume.pdf</span>
        </span>
      </div>
      <div data-mini-err hidden class="mt-3 font-mono text-[11px]" style="color:#f85149">500 · PDF generation failed</div>
    </div>
  </div>
</div>

<style is:global>
  @keyframes zdp-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-4px); }
    40% { transform: translateX(4px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(3px); }
  }
</style>
