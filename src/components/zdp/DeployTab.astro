---
import { STEPS } from "../../data/zdp";
import { SCENARIOS } from "../../lib/zdp/deploy";

const CELLS = 120;
const sc = SCENARIOS.good;
const prNotes: Record<string, string> = {
  "sandbox>staging": "promoted by PR after sandbox ran clean",
  "staging>prod": "PR #42 merged · promotes staging → prod",
};
const order = sc.ladder.map((r) => r.env);
const upNote = (i: number) => prNotes[`${order[i + 1]}>${order[i]}`] ?? "";
---

<div role="tabpanel" data-tabpanel="deploy" id="zdp-panel-deploy" aria-labelledby="zdp-tab-deploy" tabindex="0">
  <!-- step strip -->
  <ol data-strip class="m-0 flex list-none items-stretch gap-1.5 p-4 pb-3 max-[920px]:flex-col">
    {STEPS.map((s, i) => (
      <>
        {i > 0 && <li aria-hidden="true" class="self-center font-mono text-faint max-[920px]:hidden">›</li>}
        <li
          data-step={s.id}
          data-state="idle"
          class="group flex flex-1 items-start gap-2 rounded-md border border-line px-2.5 py-2 text-muted data-[state=run]:border-accent data-[state=run]:text-accent data-[state=ok]:border-[#2ea043] data-[state=ok]:text-[#2ea043] data-[state=fail]:border-[#f85149] data-[state=fail]:text-[#f85149] data-[state=skip]:text-faint"
        >
          <span data-marker aria-hidden="true" class="mt-px font-mono text-[12px]">○</span>
          <span class="min-w-0">
            <span data-step-name class="block font-mono text-[12.5px]">{s.name}</span>
            <span data-step-what class="block text-[11.5px] leading-snug text-muted group-data-[state=skip]:hidden">{s.what}</span>
            <span class="hidden text-[11.5px] leading-snug group-data-[state=skip]:block">skipped</span>
          </span>
        </li>
      </>
    ))}
  </ol>

  <!-- alarm gauge -->
  <div data-gauge class="mx-4 mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 rounded-md border border-line px-3 py-2 font-mono text-[11.5px]">
    <span class="text-muted-2">
      <span data-gauge-name class="text-ink">{sc.alarmName}</span>
      cloudwatch 5xx alarm · armed for the whole deploy · rolls back at 5 or more errors in a minute
    </span>
    <span class="tabular-nums text-ink">
      <span data-metric="err">–</span> / min · <span data-metric="state">–</span>
    </span>
  </div>

  <div class="grid grid-cols-[1fr_1.2fr] border-t border-line max-[920px]:grid-cols-1">
    <!-- ladder lane -->
    <div class="border-r border-line px-5 py-5 max-[920px]:border-r-0 max-[920px]:border-b">
      <div class="mb-2.5 font-mono text-xs text-faint"># release ladder</div>
      <ol data-ladder class="m-0 flex list-none flex-col gap-0 p-0">
        {sc.ladder.map((r, i) => (
          <>
            <li
              data-rung={r.env}
              data-rung-active={r.active ? "" : undefined}
              class="flex items-baseline gap-3 rounded-md border border-line px-3 py-2 data-[rung-active]:border-accent"
            >
              <span class="w-14 shrink-0 font-mono text-[12.5px] text-ink">{r.env}</span>
              <span class="min-w-0 flex-1">
                <span data-rung-sha class="block font-mono text-[12.5px] text-body">{r.sha}</span>
                <span data-rung-note class="block font-mono text-[11px] text-faint">{r.note}</span>
              </span>
              <span data-rung-digest class="ml-auto font-mono text-[11px] text-faint">⌕ {r.digest12}</span>
            </li>
            {i < sc.ladder.length - 1 && (
              <li aria-hidden="true" data-up-note class="py-1 pl-4 font-mono text-[11px] text-faint">▲ {upNote(i)}</li>
            )}
          </>
        ))}
      </ol>
      <div data-pr class="mt-4 rounded-md border border-line px-3 py-2 font-mono text-[11.5px] leading-relaxed">
        <div data-pr-minus class="text-[#f85149]">{sc.prDiff.minus}</div>
        <div data-pr-plus class="text-[#2ea043]">{sc.prDiff.plus}</div>
        <div data-pr-check class="mt-1 text-muted-2">{sc.prDiff.check}</div>
      </div>
    </div>

    <!-- users lane -->
    <div class="px-5 py-5">
      <div class="mb-2.5 font-mono text-xs text-faint"># user traffic, by version</div>
      <div class="flex h-9 w-full gap-0.5 overflow-hidden rounded-md" data-split role="img" aria-label="User traffic: all on blue">
        <div class="h-full rounded-[4px] transition-[width] duration-700 ease-out" data-seg="blue" style="width:100%;background:#4493f8"></div>
        <div class="h-full rounded-[4px] transition-[width] duration-700 ease-out" data-seg="green" style="width:0%;background:#2ea043"></div>
      </div>
      <div class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
        <span class="flex items-center gap-2 text-body">
          <span class="h-2.5 w-2.5 rounded-[3px]" style="background:#4493f8" aria-hidden="true"></span>
          <span data-legend="blue">blue (users are on) · {sc.blueSha}</span>
          <span class="tabular-nums text-ink" data-pct="blue">100%</span>
        </span>
        <span class="flex items-center gap-2 text-body">
          <span class="h-2.5 w-2.5 rounded-[3px]" style="background:#2ea043" aria-hidden="true"></span>
          <span data-legend="green">green (incoming) · {sc.greenSha}</span>
          <span class="tabular-nums text-ink" data-pct="green">0%</span>
        </span>
      </div>

      <div class="mb-2.5 mt-5 font-mono text-xs text-faint"># requests, as they land</div>
      <div class="flex flex-wrap gap-[3px]" data-cells role="img" aria-label="No requests yet">
        {Array.from({ length: CELLS }).map(() => (
          <span class="h-2.5 w-2.5 rounded-[2px] bg-grid transition-colors duration-200" data-cell aria-hidden="true"></span>
        ))}
      </div>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-muted-2">
        <span>served <span class="tabular-nums text-ink" data-count="served">0</span></span>
        <span>failed <span class="tabular-nums" data-count="failed">0</span></span>
        <span>on green <span class="tabular-nums text-ink" data-count="green">0</span></span>
        <span data-blast></span>
      </div>

      <div class="mt-5 flex items-start gap-3 rounded-md border border-line px-3 py-2.5">
        <div class="flex-1" data-now aria-live="polite">
          <div data-now-title class="font-mono text-[12.5px] text-ink"></div>
          <p data-now-why class="m-0 text-[13px] leading-snug text-muted">Pick a scenario above. Each step explains itself here as it runs.</p>
          <div data-now-fact class="mt-1 font-mono text-[11.5px] text-accent" hidden></div>
        </div>
        <button
          type="button"
          data-next
          hidden
          aria-disabled="true"
          class="shrink-0 rounded-md border border-accent px-3 py-1.5 font-mono text-xs text-accent transition-colors hover:bg-accent/10 aria-disabled:border-line aria-disabled:text-faint aria-disabled:hover:bg-transparent"
        >next ▸</button>
      </div>
    </div>
  </div>

  <!-- console -->
  <div class="border-t border-line bg-band px-5 py-4">
    <div
      class="h-[132px] overflow-y-auto font-mono text-[12px] leading-[1.75] text-muted-2 max-[920px]:h-[224px]"
      data-log
      role="log"
      tabindex="0"
      aria-label="Console output"
    >
      <div class="text-faint">ready: pick a scenario above.</div>
    </div>
  </div>

  <!-- outcome -->
  <div class="border-t border-line px-5 py-4 font-mono text-[13px] text-faint" data-outcome>
    <span class="text-ghost">awaiting a run</span>
  </div>
</div>
