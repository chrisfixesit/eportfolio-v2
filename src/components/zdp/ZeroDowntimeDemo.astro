---
import SectionPrompt from "../SectionPrompt.astro";
import DeployTab from "./DeployTab.astro";
import FlagTab from "./FlagTab.astro";
import { SCENARIOS } from "../../lib/zdp/deploy";
import { FLAG_SCENARIOS } from "../../lib/zdp/flag";
import { FOOTER_BADGES, PROOFS } from "../../data/zdp";

const tabs = [
  {
    id: "deploy",
    label: "▶ Deploy a release",
    sub: "new code reaches users in steps, and backs out on its own if it misbehaves",
  },
  {
    id: "flag",
    label: "⇆ Flip a feature flag",
    sub: "turn a feature on or off without deploying anything",
  },
];
const rows = [
  { id: "deploy", items: Object.values(SCENARIOS) },
  { id: "flag", items: FLAG_SCENARIOS },
];
const runBtn =
  "rounded-md border border-line-2 px-3.5 py-2 text-left font-mono text-xs leading-snug text-body transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent";
---

<section id="deploy" class="border-y border-line bg-band px-11 py-[52px] max-[920px]:px-[22px]">
  <SectionPrompt title="The deploy, step by step" path="~/zero-downtime-pipeline" cmd="./deploy.sh --watch" class="mb-3" />

  <div class="overflow-hidden rounded-xl border border-line bg-surface">
    <!-- titlebar -->
    <div class="flex flex-wrap items-center gap-2 border-b border-line px-4 py-[11px] font-mono text-xs text-faint">
      <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      zero-downtime-pipeline · replayed from the 13 Nov 2026 drill, sped up
      <span class="ml-auto"><span data-clock class="text-ink">+0:00</span> <span data-clock-origin>since deploy start</span></span>
    </div>

    <!-- big tabs -->
    <div role="tablist" aria-label="Demo" class="grid grid-cols-2 border-b border-line max-[600px]:grid-cols-1">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`zdp-tab-${t.id}`}
          data-tab={t.id}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`zdp-panel-${t.id}`}
          tabindex={i === 0 ? 0 : -1}
          class:list={[
            "border-b-2 px-4 py-3.5 text-left transition-colors",
            i === 0 ? "border-accent bg-page text-ink" : "border-transparent bg-band text-faint",
          ]}
        >
          <span class="block font-mono text-[13px]">{t.label}</span>
          <span class="mt-1 block text-[12.5px] leading-snug">{t.sub}</span>
        </button>
      ))}
    </div>

    <!-- scenarios -->
    <div class="flex flex-wrap items-center gap-2.5 border-b border-line px-4 py-3.5" data-controls>
      {rows.map((r) => (
        <div class="flex flex-wrap items-center gap-2.5" data-scenarios={r.id} hidden={r.id !== "deploy"}>
          {r.items.map((s) => (
            <button type="button" data-run={s.id} title={s.hint} aria-pressed="false" class={runBtn}>{s.label}</button>
          ))}
        </div>
      ))}
      <button
        type="button"
        data-stepmode
        aria-pressed="false"
        title="pause after each step until you press next"
        class="ml-auto rounded-md border border-line px-3 py-2 font-mono text-xs text-faint transition-colors hover:border-line-2 hover:text-body aria-pressed:border-accent aria-pressed:text-accent"
      ><span aria-hidden="true">⏸</span> step through</button>
      <button
        type="button"
        data-run="reset"
        class="rounded-md border border-line px-3 py-2 font-mono text-xs text-faint transition-colors hover:border-line-2 hover:text-body"
      >↺ reset</button>
    </div>

    <DeployTab />
    <FlagTab />

    <!-- footer -->
    {(["deploy", "flag"] as const).map((id) => (
      <div
        data-footer={id}
        hidden={id !== "deploy"}
        class="flex flex-wrap items-center gap-2 border-t border-line px-4 py-3 font-mono text-[10.5px] text-faint"
      >
        {FOOTER_BADGES[id].map((b) => (
          <span class="rounded border border-line px-1.5 py-0.5 text-faint font-mono text-[10.5px]">{b}</span>
        ))}
        <span class="ml-auto">{PROOFS}</span>
      </div>
    ))}
  </div>

  <p class="mt-3.5 max-w-[680px] font-mono text-[11.5px] leading-relaxed text-ghost">
    Replayed from the real pipeline's 13 Nov 2026 drill, sped up. Commits are illustrative.
  </p>
</section>

<script>
  import { formatClock, toWallMs, REPLAY_SPEED, makeRng } from "../../lib/zdp/clock";
  import { SCENARIOS, buildDeployScript } from "../../lib/zdp/deploy";
  import type { DeployScenarioId, DeployScenario, StepState } from "../../lib/zdp/deploy";

  (() => {
    const root = document.getElementById("deploy");
    if (!root) return;
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    type TabId = "deploy" | "flag";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let token = 0;
    let busy = false;
    let stepMode = false;
    let activeTab: TabId = "deploy";
    let advance: (() => void) | null = null;

    const clockEl = q("[data-clock]")!;
    const stepToggle = q("[data-stepmode]")!;
    const nextBtn = () => q("[data-next]");

    const sleep = (drillSeconds: number) =>
      new Promise((r) => setTimeout(r, toWallMs(drillSeconds, { speed: REPLAY_SPEED, reduce })));

    const PAUSE_MS = 2400;
    const beat = (): Promise<unknown> => {
      if (!stepMode) return new Promise((r) => setTimeout(r, reduce ? 0 : PAUSE_MS));
      nextBtn()?.setAttribute("aria-disabled", "false");
      return new Promise<void>((r) => {
        advance = () => {
          advance = null;
          nextBtn()?.setAttribute("aria-disabled", "true");
          r();
        };
      });
    };

    const setClock = (seconds: number) => {
      clockEl.textContent = formatClock(seconds);
    };

    const showNext = (on: boolean) => {
      const n = nextBtn();
      if (!n) return;
      if (!on && document.activeElement === n) stepToggle.focus();
      n.hidden = !on;
      n.setAttribute("aria-disabled", "true");
    };

    stepToggle.addEventListener("click", () => {
      stepMode = !stepMode;
      stepToggle.setAttribute("aria-pressed", String(stepMode));
      if (busy) showNext(stepMode);
      if (!stepMode) advance?.();
    });

    // Buttons are never disabled: that would throw keyboard focus back to <body>.
    const setBusy = (on: boolean, kind?: string) => {
      busy = on;
      qa("[data-run]").forEach((b) => {
        if (b.dataset.run === "reset") return;
        b.setAttribute("aria-pressed", String(on && b.dataset.run === kind));
      });
      root.setAttribute("aria-busy", String(on));
      showNext(on && stepMode);
    };

    // Filled in by the deploy and flag tab tasks.
    const resetAll = {
      deploy: (): void => {},
      flag: (): void => {},
    };
    const play: Partial<Record<TabId, (kind: string) => void>> = {};

    const doReset = () => {
      token++;
      advance?.();
      setClock(0);
      resetAll.deploy();
      resetAll.flag();
    };

    const tabs = qa('[role="tablist"] > [role="tab"]');
    const ACTIVE = ["text-ink", "border-accent", "bg-page"];
    const INACTIVE = ["text-faint", "border-transparent", "bg-band"];

    const activateTab = (id: TabId) => {
      activeTab = id;
      doReset();
      setBusy(false);
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        t.classList.remove(...(on ? INACTIVE : ACTIVE));
        t.classList.add(...(on ? ACTIVE : INACTIVE));
      });
      qa("[data-tabpanel]").forEach((p) => (p.hidden = p.dataset.tabpanel !== id));
      qa("[data-scenarios]").forEach((p) => (p.hidden = p.dataset.scenarios !== id));
      qa("[data-footer]").forEach((p) => (p.hidden = p.dataset.footer !== id));
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        const id = t.dataset.tab as TabId;
        if (id === activeTab) return;
        activateTab(id);
      });
      t.addEventListener("keydown", (e) => {
        const k = (e as KeyboardEvent).key;
        let to = -1;
        if (k === "ArrowRight") to = (i + 1) % tabs.length;
        else if (k === "ArrowLeft") to = (i - 1 + tabs.length) % tabs.length;
        else if (k === "Home") to = 0;
        else if (k === "End") to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        tabs[to].focus();
        activateTab(tabs[to].dataset.tab as TabId);
      });
    });

    qa("[data-run]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const kind = btn.dataset.run!;
        if (kind === "reset") {
          doReset();
          setBusy(false);
        } else {
          play[activeTab]?.(kind);
        }
      })
    );


    // ---------- deploy tab ----------
    const BLUE = "#4493f8";
    const GREEN = "#2ea043";
    const CRIT = "#f85149";
    const WARN = "#ff9900";
    const FAINT = "#76838f";

    const dSplit = q("[data-split]")!;
    const segBlue = q('[data-seg="blue"]')!;
    const segGreen = q('[data-seg="green"]')!;
    const pctBlue = q('[data-pct="blue"]')!;
    const pctGreen = q('[data-pct="green"]')!;
    const cellWrap = q("[data-cells]")!;
    const cells = qa("[data-cell]");
    const servedEl = q('[data-count="served"]')!;
    const failedEl = q('[data-count="failed"]')!;
    const greenEl = q('[data-count="green"]')!;
    const blastEl = q("[data-blast]")!;
    const logEl = q("[data-log]")!;
    const outcomeEl = q("[data-outcome]")!;
    const nowTitle = q("[data-now-title]")!;
    const nowWhy = q("[data-now-why]")!;
    const nowFact = q("[data-now-fact]")!;
    const NOW_IDLE = nowWhy.textContent?.trim() ?? "";
    const mErr = q('[data-metric="err"]')!;
    const mState = q('[data-metric="state"]')!;
    const gaugeName = q("[data-gauge-name]")!;
    const legendBlue = q('[data-legend="blue"]')!;
    const legendGreen = q('[data-legend="green"]')!;
    const prMinus = q("[data-pr-minus]")!;
    const prPlus = q("[data-pr-plus]")!;
    const prCheck = q("[data-pr-check]")!;

    const MARK: Record<StepState, string> = { idle: "○", run: "◐", ok: "●", fail: "✕", skip: "–" };
    const digestBySha: Record<string, string> = {};
    Object.values(SCENARIOS).forEach((sc) => sc.ladder.forEach((r) => (digestBySha[r.sha] = r.digest12)));

    let rnd = makeRng(1);
    let clock = 0;
    let nServed = 0;
    let nFailed = 0;
    let nGreen = 0;
    let idx = 0;
    let cur: DeployScenario = SCENARIOS.good;

    const setSplit = (g: number) => {
      segBlue.style.width = `${100 - g}%`;
      segGreen.style.width = `${g}%`;
      pctBlue.textContent = `${100 - g}%`;
      pctGreen.textContent = `${g}%`;
      dSplit.setAttribute(
        "aria-label",
        `User traffic: blue ${cur.blueSha} ${100 - g} percent, green ${cur.greenSha} ${g} percent`
      );
    };

    const setMetrics = (count: string, state: string, breach = false) => {
      mErr.textContent = count;
      mState.textContent = state;
      mErr.style.color = breach ? CRIT : "";
      mState.style.color = breach ? CRIT : "";
    };

    const applyScenario = (sc: DeployScenario) => {
      cur = sc;
      legendBlue.textContent = `blue (users are on) · ${sc.blueSha}`;
      legendGreen.textContent = `green (incoming) · ${sc.greenSha}`;
      gaugeName.textContent = sc.alarmName;
      sc.ladder.forEach((r) => {
        const li = q(`[data-rung="${r.env}"]`);
        if (!li) return;
        q(`[data-rung="${r.env}"] [data-rung-sha]`)!.textContent = r.sha;
        q(`[data-rung="${r.env}"] [data-rung-note]`)!.textContent = r.note;
        q(`[data-rung="${r.env}"] [data-rung-digest]`)!.textContent = `⌕ ${r.digest12}`;
        if (r.active) li.setAttribute("data-rung-active", "");
        else li.removeAttribute("data-rung-active");
      });
      prMinus.textContent = sc.prDiff.minus;
      prPlus.textContent = sc.prDiff.plus;
      prCheck.textContent = sc.prDiff.check;
      setSplit(0);
    };

    const setStep = (id: string, state: StepState) => {
      const li = q(`[data-step="${id}"]`);
      if (!li) return;
      li.dataset.state = state;
      const name = li.querySelector("[data-step-name]")?.textContent ?? "";
      (li.querySelector("[data-marker]") as HTMLElement).textContent = MARK[state];
      li.setAttribute("aria-label", `${name}: ${state}`);
    };

    const showNow = (title: string, why: string, fact?: string) => {
      nowTitle.textContent = title;
      nowWhy.textContent = why;
      nowFact.textContent = fact ?? "";
      nowFact.hidden = !fact;
    };

    const stamp = (at?: number) => {
      clock = at ?? clock + 7 + Math.floor(rnd() * 11);
      setClock(clock);
      return formatClock(clock);
    };

    const say = (text: string, tone?: "ok" | "warn" | "crit", at?: number) => {
      const line = document.createElement("div");
      const t = document.createElement("span");
      t.style.color = FAINT;
      t.textContent = stamp(at);
      const body = document.createElement("span");
      body.style.color = tone === "ok" ? GREEN : tone === "crit" ? CRIT : tone === "warn" ? WARN : "";
      body.textContent = text;
      line.append(t, " ", body);
      logEl.appendChild(line);
      logEl.scrollTop = logEl.scrollHeight;
    };

    const paint = (kind: "blue" | "green" | "fail") => {
      if (idx >= cells.length) return;
      const c = cells[idx++];
      if (kind === "fail") {
        c.style.background = CRIT;
        c.title = `500 · green ${cur.greenSha}`;
        nFailed++;
        nGreen++;
      } else {
        c.style.background = kind === "blue" ? BLUE : GREEN;
        c.title = kind === "blue" ? `200 · blue ${cur.blueSha}` : `200 · green ${cur.greenSha}`;
        nServed++;
        if (kind === "green") nGreen++;
      }
      servedEl.textContent = String(nServed);
      failedEl.textContent = String(nFailed);
      greenEl.textContent = String(nGreen);
      failedEl.style.color = nFailed > 0 ? CRIT : "";
      cellWrap.setAttribute("aria-label", `${nServed + nFailed} requests: ${nServed} served, ${nFailed} failed`);
    };

    const finish = (glyph: string, text: string, color: string, note: string) => {
      outcomeEl.textContent = "";
      const head = document.createElement("div");
      head.style.color = color;
      head.textContent = `${glyph} ${text.replace("{served}", String(nServed)).replace("{failed}", String(nFailed))}`;
      const sub = document.createElement("div");
      sub.className = "mt-1 text-[12px] leading-snug";
      sub.style.color = "#8b97a3";
      sub.textContent = note;
      outcomeEl.append(head, sub);
    };

    const resetDeploy = () => {
      rnd = makeRng(1);
      clock = 0;
      nServed = nFailed = nGreen = idx = 0;
      applyScenario(SCENARIOS.good);
      cells.forEach((c) => {
        c.style.background = "";
        c.removeAttribute("title");
      });
      cellWrap.setAttribute("aria-label", "No requests yet");
      servedEl.textContent = "0";
      failedEl.textContent = "0";
      greenEl.textContent = "0";
      failedEl.style.color = "";
      blastEl.textContent = "";
      blastEl.style.color = "";
      setMetrics("–", "–");
      qa("[data-strip] [data-step]").forEach((li) => setStep(li.dataset.step!, "idle"));
      showNow("", NOW_IDLE);
      logEl.textContent = "";
      const ready = document.createElement("div");
      ready.className = "text-faint";
      ready.textContent = "ready: pick a scenario above.";
      logEl.appendChild(ready);
      outcomeEl.textContent = "";
      const wait = document.createElement("span");
      wait.className = "text-ghost";
      wait.textContent = "awaiting a run";
      outcomeEl.appendChild(wait);
    };
    resetAll.deploy = resetDeploy;

    q("[data-next]")?.addEventListener("click", () => advance?.());

    async function playDeploy(id: string) {
      doReset();
      const me = token;
      const alive = () => me === token;
      const sc = SCENARIOS[id as DeployScenarioId];
      if (!sc) return;
      applyScenario(sc);
      setBusy(true, id);
      logEl.textContent = "";
      let canaryAt = 0;

      for (const ev of buildDeployScript(sc.id)) {
        switch (ev.t) {
          case "step":
            setStep(ev.id, ev.state);
            if (ev.id === "canary" && ev.state === "run") canaryAt = clock;
            break;
          case "say":
            say(ev.text, ev.tone, ev.at ?? (ev.atFromCanary !== undefined ? canaryAt + ev.atFromCanary : undefined));
            break;
          case "split":
            setSplit(ev.green);
            break;
          case "stream":
            for (let i = 0; i < ev.n; i++) {
              const toGreen = rnd() * 100 < ev.greenPct;
              if (toGreen && rnd() < (ev.errRate ?? 0)) paint("fail");
              else paint(toGreen ? "green" : "blue");
              await sleep(0.76);
              if (!alive()) return;
            }
            break;
          case "metrics":
            setMetrics(ev.count, ev.state, ev.breach);
            break;
          case "beat":
            await beat();
            if (!alive()) return;
            break;
          case "sleep":
            await sleep(ev.drillSeconds);
            if (!alive()) return;
            break;
          case "now":
            showNow(ev.title, ev.why, ev.fact);
            break;
          case "finish":
            finish(ev.glyph, ev.text, ev.tone === "ok" ? GREEN : WARN, ev.note);
            break;
          case "ladder": {
            const li = q(`[data-rung="${ev.env}"]`);
            if (!li) break;
            const recorded = ev.note.startsWith("last-good");
            li.querySelector("[data-rung-sha]")!.textContent = `${recorded ? "● " : ""}${ev.sha}`;
            li.querySelector("[data-rung-note]")!.textContent = ev.note;
            li.querySelector("[data-rung-digest]")!.textContent = `⌕ ${digestBySha[ev.sha] ?? ""}`;
            break;
          }
          case "blast":
            blastEl.textContent = ev.text;
            blastEl.style.color = WARN;
            break;
        }
      }
      setBusy(false);
    }
    play.deploy = playDeploy;
  })();
</script>
