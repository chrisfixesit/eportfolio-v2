---
import { siteContent } from "../data/content";

const { nav } = siteContent;
---

<nav
  id="site-nav"
  class="sticky top-0 z-50 border-b border-line bg-[rgba(12,16,21,0.9)] font-mono backdrop-blur-[10px]"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-8 py-3.5 max-[720px]:relative">
    <a href="#top" class="flex items-center gap-3.5" aria-label={`${nav.prompt} — back to top`}>
      <span class="flex gap-[7px]" aria-hidden="true">
        <span class="h-[11px] w-[11px] rounded-full bg-tl-red"></span>
        <span class="h-[11px] w-[11px] rounded-full bg-tl-yellow"></span>
        <span class="h-[11px] w-[11px] rounded-full bg-tl-green"></span>
      </span>
      <span class="text-[13px] text-faint max-[720px]:hidden">{nav.prompt}</span>
    </a>

    <button
      id="nav-burger"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="hidden cursor-pointer rounded-md border border-line-2 bg-transparent px-[11px] py-[5px] font-mono text-lg leading-none text-body max-[720px]:inline-flex"
    >≡</button>

    <div
      id="nav-links"
      class="flex flex-wrap items-center gap-6 text-[13px] max-[720px]:absolute max-[720px]:inset-x-0 max-[720px]:top-full max-[720px]:hidden max-[720px]:flex-col max-[720px]:items-stretch max-[720px]:gap-0.5 max-[720px]:border-b max-[720px]:border-line max-[720px]:bg-[rgba(10,13,17,0.98)] max-[720px]:px-8 max-[720px]:pb-4 max-[720px]:pt-2 max-[720px]:[&.open]:flex"
    >
      {nav.links.map((link) => (
        <a
          href={link.href}
          data-nav
          class="text-muted-2 transition-colors hover:text-accent max-[720px]:border-b max-[720px]:border-[#14191f] max-[720px]:py-2.5"
        >{link.label}</a>
      ))}
      <a
        href={nav.resume.href}
        class="rounded-[5px] border border-accent px-3 py-[3px] text-accent transition-colors hover:bg-accent hover:text-page max-[720px]:mt-2 max-[720px]:self-start"
      >{nav.resume.label}</a>
    </div>
  </div>
</nav>

<script>
  // Mobile hamburger menu
  const burger = document.getElementById("nav-burger");
  const links = document.getElementById("nav-links");
  if (burger && links) {
    burger.addEventListener("click", () => {
      const open = links.classList.toggle("open");
      burger.textContent = open ? "✕" : "≡";
      burger.setAttribute("aria-expanded", String(open));
    });
    links.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        links.classList.remove("open");
        burger.textContent = "≡";
        burger.setAttribute("aria-expanded", "false");
      })
    );
  }

  // Scroll-spy: the nav link for the section in view turns orange/bold
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>("#site-nav a[data-nav]")];
  const map: Record<string, HTMLAnchorElement> = {};
  navLinks.forEach((a) => {
    const id = a.getAttribute("href")?.slice(1);
    if (id) map[id] = a;
  });
  const clear = () =>
    navLinks.forEach((a) => {
      a.style.color = "";
      a.style.fontWeight = "";
    });
  const io = new IntersectionObserver(
    (entries) => {
      const vis = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
      if (vis[0]) {
        clear();
        const a = map[vis[0].target.id];
        if (a) {
          a.style.color = "#ff9900";
          a.style.fontWeight = "700";
        }
      }
    },
    { rootMargin: "-45% 0px -50% 0px", threshold: [0, 0.25, 0.5] }
  );
  Object.keys(map).forEach((id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>
