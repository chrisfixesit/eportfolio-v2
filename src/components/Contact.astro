---
import { siteContent } from "../data/content";
import SectionPrompt from "./SectionPrompt.astro";
import ContactForm from "./ContactForm";
import { execSync } from "node:child_process";

const { contact, footer } = siteContent;

// Build stamp: Amplify exposes the deployed commit as AWS_COMMIT_ID; fall back to local git.
const gitHead = (): string => {
  try {
    return execSync("git rev-parse HEAD").toString().trim();
  } catch {
    return "";
  }
};
const commit = (process.env.AWS_COMMIT_ID ?? gitHead()).slice(0, 7);
const builtOn = new Date().toISOString().slice(0, 10);
---

<section id="contact" class="border-t border-line bg-surface px-11 py-12 max-[920px]:px-[22px]">
  <SectionPrompt title={contact.title} path={contact.path} cmd={contact.cmd} class="mb-4" />

  <div class="flex flex-wrap items-end justify-between gap-6 max-[920px]:flex-col max-[920px]:items-start [&>*]:min-w-0 [&>*]:max-w-full">
    <div>
      <div class="font-mono text-[34px] font-bold tracking-[-0.02em] text-ink max-[420px]:text-[26px]">{contact.heading}</div>
      <div class="mt-2.5 max-w-[460px] text-base text-muted">{contact.blurb}</div>
      <div class="mt-3 font-mono text-[13px] text-green">{contact.now}</div>
      <div class="mt-2 font-mono text-[13px] text-muted-2">
        {contact.clients.label}:
        <a href={contact.clients.href} target="_blank" rel="noopener noreferrer" class="text-accent transition-opacity hover:opacity-70">{contact.clients.linkLabel}</a>
      </div>
    </div>
    <div class="flex min-w-0 max-w-full flex-col gap-2.5 break-words font-mono text-sm text-body [overflow-wrap:anywhere]">
      <a href={`mailto:${contact.email}`} class="text-accent">{contact.email}</a>
      <a href={contact.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">{contact.githubDisplay}</a>
      <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">{contact.linkedinDisplay}</a>
      <span class="text-faint">{contact.location}</span>
    </div>
  </div>

  <!-- contact form in a terminal frame -->
  <div class="mt-9 max-w-[640px] overflow-hidden rounded-xl border border-line bg-band">
    <div class="flex items-center gap-2 border-b border-line px-3.5 py-[9px] font-mono text-[11px] text-faint">
      <span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>corbin@cloud — send-message.sh
    </div>
    <div class="p-5">
      <ContactForm client:visible />
    </div>
  </div>

  <!-- footer -->
  <div class="mt-9 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5 font-mono text-xs text-faint">
    <span>
      {footer.copyright}
      {commit && <span class="text-ghost"> # deployed {commit} on {builtOn}</span>}
    </span>
    <div class="flex flex-wrap gap-[18px]">
      {footer.links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="text-muted-2 transition-colors hover:text-accent"
        >{link.label}</a>
      ))}
    </div>
  </div>
</section>
