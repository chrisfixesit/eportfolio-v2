---
import { siteContent } from "../data/content";
import ContactForm from "./ContactForm";

const { contact, footer } = siteContent;
---

<section id="contact" class="border-t border-line bg-surface px-11 py-12 max-[920px]:px-[22px]">
  <div class="section-label mb-4">
    {contact.label} <span class="text-faint">{contact.cmd}</span>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-6 max-[920px]:flex-col max-[920px]:items-start">
    <div>
      <div class="font-mono text-[34px] font-bold tracking-[-0.02em] text-ink">{contact.heading}</div>
      <div class="mt-2.5 max-w-[460px] text-base text-muted">{contact.blurb}</div>
    </div>
    <div class="flex flex-col gap-2.5 font-mono text-sm text-body">
      <a href={`mailto:${contact.email}`} class="text-accent">{contact.email}</a>
      <a href={contact.phoneHref}>{contact.phone}</a>
      <a href={contact.github} target="_blank" rel="noopener noreferrer">{contact.githubDisplay}</a>
      <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">{contact.linkedinDisplay}</a>
      <span class="text-faint">{contact.location}</span>
    </div>
  </div>

  <!-- contact form in a terminal frame -->
  <div class="mt-9 max-w-[640px] overflow-hidden rounded-xl border border-line bg-band">
    <div class="flex items-center gap-2 border-b border-line px-3.5 py-[9px] font-mono text-[11px] text-faint">
      <span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>corbin@cloud — send-message.sh
    </div>
    <div class="p-5">
      <ContactForm client:visible />
    </div>
  </div>

  <!-- footer -->
  <div class="mt-9 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5 font-mono text-xs text-faint">
    <span>{footer.copyright}</span>
    <div class="flex flex-wrap gap-[18px]">
      {footer.links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="text-muted-2 transition-colors hover:text-accent"
        >{link.label}</a>
      ))}
    </div>
  </div>
</section>
