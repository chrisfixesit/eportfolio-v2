---
import { siteContent } from "../data/content";

const { certifications } = siteContent;
---

<section id="certifications" class="px-11 pb-[52px] pt-2 max-[920px]:px-[22px]">
  <div class="section-label mb-[26px]">{certifications.label}</div>
  <div class="flex flex-wrap gap-2.5 font-mono text-[13px]">
    {certifications.badges.map((badge) =>
      badge.inProgress ? (
        <span class="rounded-lg border border-dashed border-accent px-4 py-2.5 text-accent">
          {badge.name} <span class="opacity-70">{badge.meta}</span>
        </span>
      ) : (
        <span class="rounded-lg border border-line-2 px-4 py-2.5 text-body">
          {badge.name}{badge.meta && <span class="text-faint"> {badge.meta}</span>}
        </span>
      )
    )}
  </div>
</section>
